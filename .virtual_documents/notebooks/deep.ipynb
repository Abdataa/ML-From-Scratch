# Bayesian Linear Regression Implementation ---->practices
import pandas as pd
import numpy as np 
import matplotlib.pyplot as plt
np.random.seed(42)
# Load data
data=pd.read_csv('../data/train.csv')
# selecting only numeric data 
data_numeric=data.select_dtypes(include='number').dropna()
data_object=data.select_dtypes(include='object')

X=data_numeric.drop(['SalePrice'],axis=1).values
y=data_numeric[['SalePrice']].values

n_features=X.shape[1] # dimension 

## prior mean
m_0=np.zeros(n_features)
## prior variance 
s_0=0.23*np.eye(n_features)
# noisy variance 
sigma2=1e6
# prior parameter values distribution
prior_theta=np.random.multivariate_normal(m_0,s_0)
#prior distribution over function
fx=prior_theta@X[:1000].T + np.sqrt(sigma2)
mean_f=X[:1000]@m_0
var_f=np.sum(X[:1000]@s_0*X[:1000],axis=1)
fxx=np.random.normal(mean_f,var_f)


color=[['fxx','fx','yx'],['red','blue','black']]
for i ,c,l in zip( [fxx,fx,y], color[1],color[0] ):
    plt.plot(i, color=c, label=l);
plt.legend()    
plt.show();


fig,axes=plt.subplots(1,3, figsize=(20,10))

for ax, i in zip( axes.ravel(),[fxx,fx,y]):
    ax.plot(i);
plt.figure(figsize=(8,5))    
plt.show();    



